{
  "info": {
    "name": "COMP3123 Lab 6 — Joshua Zaakir — 101578900",
    "description": "Run in order against the MongoDB Atlas-connected server. The collection creates, verifies, updates and deletes its own test note.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "noteId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 — Root welcome",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Welcome message returned\", () => pm.expect(pm.response.text()).to.include(\"Welcome\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Create test note",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": {\n    \"noteTitle\": \"Sample Note Title\",\n    \"noteDescription\": \"Sample Note Description\",\n    \"priority\": \"HIGH\",\n    \"dateAdded\": \"06/Oct/2025\",\n    \"dateUpdated\": \"06/Oct/2025\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/notes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const note = pm.response.json();",
              "  pm.collectionVariables.set(\"noteId\", note._id);",
              "  pm.test(\"Saved note has an ID and all five fields\", () => {",
              "    pm.expect(note._id).to.be.a(\"string\").and.not.empty;",
              "    [\"noteTitle\", \"noteDescription\", \"priority\", \"dateAdded\", \"dateUpdated\"].forEach((key) => pm.expect(note).to.have.property(key));",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — List all notes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/notes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Response is an array containing the created note\", () => {",
              "  const notes = pm.response.json();",
              "  pm.expect(notes).to.be.an(\"array\");",
              "  pm.expect(notes.some((note) => note._id === pm.collectionVariables.get(\"noteId\"))).to.be.true;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — Get created note",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/notes/{{noteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Correct note returned\", () => pm.expect(pm.response.json()._id).to.equal(pm.collectionVariables.get(\"noteId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 — Update created note",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": {\n    \"noteTitle\": \"Updated Note Title\",\n    \"noteDescription\": \"This note has been updated\",\n    \"priority\": \"MEDIUM\",\n    \"dateAdded\": \"06/Oct/2025\",\n    \"dateUpdated\": \"16/Oct/2026\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/notes/{{noteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Updated values returned\", () => {",
              "  const note = pm.response.json();",
              "  pm.expect(note.noteTitle).to.equal(\"Updated Note Title\");",
              "  pm.expect(note.priority).to.equal(\"MEDIUM\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 — Confirm persisted update",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/notes/{{noteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Update persisted\", () => pm.expect(pm.response.json().noteTitle).to.equal(\"Updated Note Title\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 — Delete test note",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/notes/{{noteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Success message returned\", () => pm.expect(pm.response.json().message).to.include(\"deleted\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 — Deleted note is not found",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/notes/{{noteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 — Missing POST content",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/notes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 — Invalid note ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/notes/not-a-valid-id"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 — Missing PUT content",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/notes/{{noteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 — Invalid priority",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": {\n    \"noteTitle\": \"Invalid Priority\",\n    \"noteDescription\": \"This request should fail\",\n    \"priority\": \"INVALID\",\n    \"dateAdded\": \"16/Oct/2026\",\n    \"dateUpdated\": \"16/Oct/2026\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/notes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 — Malformed JSON",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"content\":",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/notes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
